# Copy this file to .env.local and adjust. Never commit .env.local.
#   cp .env.example .env.local
#
# Never put secrets in variables prefixed with NEXT_PUBLIC_: those values are
# sent to every visitor's browser.

# Where the Flask API runs. Server-side only: browsers call this site's /api,
# and src/proxy.ts forwards those requests here. Must be a bare origin (no
# path, no trailing slash). Optional for `npm run dev` (defaults to the
# address below); required for `npm run build` and `npm start`.
API_ORIGIN=http://127.0.0.1:5000

# The secret shared with the API (backend/.env.example). Server-side only.
# Leave unset locally unless the backend sets it too; required on staging and
# production, where the API refuses requests without it.
# PROXY_SHARED_SECRET=
