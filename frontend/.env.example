# Copy this file to .env.local and adjust. Never commit .env.local.
#   cp .env.example .env.local
#
# Never put secrets in variables prefixed with NEXT_PUBLIC_: those values are
# sent to every visitor's browser.

# Where the Flask API runs. Server-side only: browsers call this site's /api,
# and Next.js forwards those requests here. Must be a bare origin (no path,
# no trailing slash). Optional for `npm run dev` (defaults to the address
# below); required for `npm run build` and `npm start`, which must use the
# same value because the forwarding rule is fixed at build time.
API_ORIGIN=http://127.0.0.1:5000
