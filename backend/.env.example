# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# development | production  (if unset, the app applies production checks)
APP_ENV=development

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this placeholder.
SECRET_KEY=change-me

# Log detail: DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
LOG_LEVEL=INFO

# PostgreSQL connection strings (psycopg 3 driver). For local development,
# scripts/set_local_db_passwords.py fills in all four with generated passwords.
# See docs/database.md.

# Runtime API connection: sms_app can read and write rows only.
DATABASE_URL=postgresql+psycopg://sms_app:CHANGE_ME@127.0.0.1:5432/sms_dev
# Migrations only: sms_migrator owns the schema.
MIGRATION_DATABASE_URL=postgresql+psycopg://sms_migrator:CHANGE_ME@127.0.0.1:5432/sms_dev

# Automated tests. Database names must end in _test or the tests refuse to run.
TEST_DATABASE_URL=postgresql+psycopg://sms_app:CHANGE_ME@127.0.0.1:5432/sms_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://sms_migrator:CHANGE_ME@127.0.0.1:5432/sms_test

# The browser origin of the frontend: the only site allowed to send
# state-changing requests (CSRF protection). Scheme and host only, no path or
# trailing slash. Development defaults to http://127.0.0.1:3000; production
# must set it, using https.
# FRONTEND_ORIGIN=http://127.0.0.1:3000

# How many reverse proxies sit in front of the API whose X-Forwarded-For header
# is trusted for the client IP used by login rate limiting. Leave at 0 unless
# the proxy chain has been measured (docs/deployment.md), or anyone could fake
# their IP. Staging uses 0 with PROXY_SHARED_SECRET instead.
TRUSTED_PROXY_COUNT=0

# Shared with the frontend (frontend/.env.example): when set, the API refuses
# requests that did not come through the frontend (health checks excepted),
# and trusts the visitor IP the frontend passes on. Required in production;
# optional in development. At least 32 random characters, generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PROXY_SHARED_SECRET=
